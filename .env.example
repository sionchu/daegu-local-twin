# Public map configuration. These are not secrets.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# Optional raster-dem TileJSON override. Leave blank to use the built-in
# AWS Open Data Terrain Tiles (Terrarium) fallback.
NEXT_PUBLIC_DEM_TILEJSON_URL=

NEXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors
